
vertexlitgeneric
{

	$basetexture models/characters/citizen/female/body/rebel_sheet_bloody_female_d
	$bumpmap models/characters/citizen/female/body/rebel_sheet_female_b
	$lightwarptexture dev/identitylightwarp

	$halflambert 1
	$ambientocclusion 1
	// $nocull 1

	$phong 1
	$phongexponent 1
	$phongboost 0.3
	$phongfresnelranges "[ 1 0.5 0.1 ]"

	$normalmapalphaenvmapmask 1

	$proxytoggle 1
	Proxies
	{

		Equals
		{

			srcVar1 $proxytoggle // Disable Proxies
			resultVar $color // The shader parameter to be manipulated

		}

	}

}

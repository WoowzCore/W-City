
vertexlitgeneric
{

	$basetexture models/characters/citizen/female/hands/female_hands_glove_d
	$bumpmap models/characters/citizen/female/hands/female_hands_glove_b

	$halflambert 1
	$ambientocclusion 1
	
	$phong 1
	$phongexponent 15
	$phongboost 0.05
	$phongtint "[ 0.85 0.85 1 ]"
	$phongfresnelranges "[ 0.3 0.65 30 ]"
	$phongalbedotint 1
	
	$detail detail/leather2
	$detailscale 8
	$detailblendfactor 0.7
	$detailblendmode 0
	
	$proxytoggle 1
	proxies
	{

		Equals
		{

			srcVar1 $proxytoggle // disable proxies
			resultVar $color // the shader parameter to be manipulated

		}

	}

}
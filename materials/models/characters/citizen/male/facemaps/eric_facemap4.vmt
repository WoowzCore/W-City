
//	Eric Facemap 4
//	Texture @ HL2
//	Shaders @ Reverend V92
//	Creation: 2017/03/30
//	Update: 2019/12/21

vertexlitgeneric
{

	$basetexture models/characters/citizen/male/facemaps/eric_facemap4_d
	$bumpmap models/characters/citizen/male/facemaps/eric_facemap_b
	$lightwarptexture dev/identitylightwarp

	$surfaceprop flesh
	$ambientocclusion 1
	$halflambert 1
	$nocull 0
	$nodecal 0
	$diffuseexp 1.5

	$phong 1
	$phongboost 8
	$phongexponent 0.1
	$phongtint "{ 150 120 120 }"
	$phongfresnelranges "[ 0.1 0.2 1 ]"

	$detail detail/skin1
	$detailscale 12
	$detailblendfactor 0.9
	$detailblendmode 0

	$proxytoggle 1
	Proxies
	{

		Equals
		{

			srcVar1 $proxytoggle // Disable Proxies
			resultVar $color // The shader parameter to be manipulated

		}

	}

}

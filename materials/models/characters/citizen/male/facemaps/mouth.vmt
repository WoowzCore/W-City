
//	Mouth
//	Texture @ HL2
//	Shaders @ Reverend V92
//	Creation: 2017/03/30
//	Update: 2019/12/21

vertexlitgeneric
{

	$basetexture models/characters/citizen/male/facemaps/mouth_d
	$bumpmap dev/bump_normal
	$lightwarptexture dev/identitylightwarp

	$surfaceprop tile
	$ambientocclusion 1
	$halflambert 1
	$nocull 0
	$nodecal 0
	$diffuseexp 1.5

	$phong 1
	$phongboost 0.1
	$phongexponent 5
	$phongtint "[ 0.85 0.85 1 ]"
	$phongfresnelranges "[ 0.1 0.2 1 ]"
	
	$proxytoggle 1
	Proxies
	{

		Equals
		{

			srcVar1 $proxytoggle // Disable Proxies
			resultVar $color // The shader parameter to be manipulated

		}

	}

}

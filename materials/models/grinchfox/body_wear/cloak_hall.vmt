VertexLitGeneric
{
	$basetexture "models/grinchfox/body_wear/cloak_hall"
	$selfillum 1
	$selfillummask "models/grinchfox/body_wear/cloak_hall_illum"
	$selfillummaskscale 1
	$halflambert 1
//	$basetexturetransform "center .5 .5 scale 1 2 rotate 0 translate 0 0.5"
	$bumpmap "models/grinchfox/body_wear/cloak_normal"

	$detail "models/grinchfox/body_wear/cloak"
	$detailblendfactor 1
	$detailscale 1
//	$detailblendmode 8

	$phong 1
	$phongexponent   "20"
 	$phongboost   "1"
 	$phongfresnelranges   "[0.6 0.6 1]"
}

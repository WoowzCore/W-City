VertexLitGeneric
{
	$basetexture "models/grinchfox/rp/foodbox"
	$bumpmap "models/grinchfox/rp/foodbox_normal"
	$normalmapalphaenvmapmask 1
	$envmap "env_cubemap"
	$envmaptint "[0.4 0.4 0.4]"
	$envcontrast 1
	$phong 1
	$phongexponent 20
	$phongboost 10
	$phongfresnelranges		"[0 0.5 1]"
	Proxies
	{
		ProceduralTexture
		{
			resultvar "$basetexture"
		}
	}
}

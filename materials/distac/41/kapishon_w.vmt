"VertexLitGeneric"
{
	"$basetexture" "DisTac/41/kapishon_W"
	"$bumpmap" "DisTac/41/kapishon_n"
	
	
	"$halflambert" "1"
	
	"$phong" "1"
	"$phongexponent" "4"
	"$phongboost" ".1"
